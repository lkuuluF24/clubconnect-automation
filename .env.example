# Un bloc par compte déclaré sous accounts: dans config.yaml (nom en MAJUSCULES)
ACCOUNT_LUC_EMAIL=
ACCOUNT_LUC_PASSWORD=
# Optionnel : prévenir ce compte du résultat de ses réservations (POST par défaut, ou PUT)
# ACCOUNT_LUC_WEBHOOK=https://ha.exemple.fr/api/webhook/<id-du-webhook>
# ACCOUNT_LUC_WEBHOOK_METHOD=POST

# Optionnel : résumé global de chaque passage, tous comptes confondus
# NOTIFY_WEBHOOK_URL=https://ha.exemple.fr/api/webhook/<id-du-webhook>
